# ================================================================
# DJI Store TN — Variables d'environnement
# Copier ce fichier en .env.local et remplir toutes les valeurs.
# Ne JAMAIS commiter .env.local (il est dans .gitignore).
# ================================================================

# ── Supabase (obligatoire) ───────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clé service-role — ne PAS préfixer NEXT_PUBLIC_ (ne pas exposer au client)
# Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Web Push / Notifications (obligatoire pour les notifs push) ──
# Générer avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:votre@email.com

# ── Emails via Resend (obligatoire pour l'envoi d'emails) ────────
# 1. Créer un compte sur https://resend.com (gratuit : 3 000 emails/mois)
# 2. API Keys → Create API Key (Full Access)
# 3. Coller la clé ci-dessous
RESEND_API_KEY=re_...

# Expéditeur :
#   - Sans domaine vérifié → conserver "onboarding@resend.dev" (emails de test)
#   - Avec domaine vérifié → "DJI Store TN <no-reply@votre-domaine.tn>"
EMAIL_FROM=DJI Store TN <onboarding@resend.dev>

# ── URL publique du site ─────────────────────────────────────────
# En local : http://localhost:3000
# En production : https://votre-domaine.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
